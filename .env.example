# ===============================================
# Yazhisai Cloud Kitchen - Environment Variables Template
# Copy this file to .env or .env.local for local development
# NEVER commit real secret values to Git repositories
# ===============================================

# --- Express Backend Environment Variables ---
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_kitchen?schema=public
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:3000
ADDITIONAL_ALLOWED_ORIGINS=https://yazhisaicloudkitchen.in,https://www.yazhisaicloudkitchen.in
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary Credentials for Food Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Next.js Frontend Environment Variables ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
