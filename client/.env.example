# ============================================================================
# YAZHISAI CLOUD KITCHEN - CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local frontend development
# ============================================================================

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Yazhisai Cloud Kitchen"

# Backend Express API Service URL (Monorepo Node/Express Server)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Supabase PostgreSQL Cloud / Local Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Server-Side Supabase Service Role Key (NEVER expose to client browser)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"
