# Express Backend Environment Variables Template

# Express Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Neon Pooled Connection for app queries)
DATABASE_URL=postgresql://user:password@ep-still-breeze-b33r7irj-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# PostgreSQL Direct Connection String (Neon Direct Connection for Prisma Migrations - WITHOUT -pooler)
DIRECT_URL=postgresql://user:password@ep-still-breeze-b33r7irj.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Secret Key for JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Deployed Frontend Web App URL (for CORS)
CLIENT_URL=http://localhost:3000
ADDITIONAL_ALLOWED_ORIGINS=https://yazhisaicloudkitchen.in,https://www.yazhisaicloudkitchen.in

# Razorpay API Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary Credentials for Food Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fast2SMS OTP Gateway (https://www.fast2sms.com)
# Used for real SMS OTP delivery in production.
# Get your API key from: Fast2SMS Dashboard -> Dev API -> API Credentials
FAST2SMS_API_KEY=

# OTP Bypass Flag (LOCAL DEVELOPMENT ONLY)
# Set to 'true' to skip real SMS & Email calls during local development.
# DEV_OTP_BYPASS must NEVER be set to 'true' in production (Render) env vars.
# When true (or when RESEND_API_KEY is unset), OTP is printed to server console logs for manual retrieval.
# Default (unset / false): real APIs are called.
DEV_OTP_BYPASS=false

# Resend Transactional Email API (https://resend.com)
# Used for real Email OTP password reset delivery in production & staging.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Yazhisai Cloud Kitchen <otp@yazhisaicloudkitchen.in>"

# External Cron & Background Jobs
# Secret token to authenticate POST /api/orders/cleanup-abandoned (x-cron-secret header)
CRON_SECRET=
# Internal order cleanup interval timer. Default is disabled (false) so Neon PostgreSQL can scale to zero CU.
# Set to 'true' only if you do NOT use external cron triggers (e.g. cron-job.org).
ENABLE_INTERNAL_ORDER_CLEANUP=false

# Telegram Admin New-Order Alerts (https://core.telegram.org/bots/api)
# Bot token from @BotFather; chat ID of the admin who should receive alerts.
# If either is unset, alerts are skipped silently (orders are never blocked).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
