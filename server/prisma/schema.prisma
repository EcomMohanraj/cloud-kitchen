generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  phone           String?   @unique
  email           String?   @unique
  password        String?
  name            String?
  address         String?
  resetOtp        String?
  resetOtpExpires DateTime?
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  createdAt       DateTime  @default(now())
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?  // e.g. "Home", "Work"
  fullAddress String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model SlotsSchedule {
  id              String   @id @default(uuid())
  date            String   // Format: "YYYY-MM-DD"
  slotType        String   // "BREAKFAST", "SNACKS", "LUNCH", "DINNER"
  isAvailable     Boolean  @default(false)
  isActive        Boolean  @default(false)
  cutoffTime      String?  @default("09:00 AM")
  orderCutoffTime String?  @default("06:00 AM")
  maxOrders       Int      @default(50)
  currentOrders   Int      @default(0)

  @@unique([date, slotType])
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  nameTamil       String?
  description     String?
  price           Float
  slotCategory    String      // "BREAKFAST", "SNACKS", "LUNCH", "DINNER"
  isAvailable     Boolean     @default(true)
  isVeg           Boolean     @default(true)
  imageUrl        String?
  ingredients     String?
  prepTimeMinutes Int         @default(20)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  reviews         Review[]
}

model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  deliveryAddress String
  bookingDate     String      // Format: "YYYY-MM-DD"
  slotType        String      // "BREAKFAST", "SNACKS", "LUNCH", "DINNER"
  preferredTime   String
  paymentMethod   String      // "COD" | "ONLINE"
  paymentStatus   String      // "PENDING" | "PAID" | "FAILED"
  paymentId       String?
  paymentCollectedAt DateTime?
  paymentCollectedBy String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  orderStatus     String      @default("PENDING")
  subtotal        Float
  deliveryFee     Float
  totalAmount     Float
  createdAt       DateTime    @default(now())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  preparedByChefId  String?
  preparedByChef    Chef?            @relation(fields: [preparedByChefId], references: [id])
  deliveryLatitude  Float?
  deliveryLongitude Float?
  items           OrderItem[]
  reviews         Review[]
}

model DeliveryPartner {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  password  String
  isActive  Boolean  @default(true)
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Chef {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  password  String   // bcrypt hashed
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}


model DriverLocation {
  id                String   @id @default(uuid())
  deliveryPartnerId String   @unique
  orderId           String?
  latitude          Float
  longitude         Float
  updatedAt         DateTime @updatedAt
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItemName String
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
}

model Review {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  orderId     String   // the specific order that makes this review "verified"
  order       Order    @relation(fields: [orderId], references: [id])
  rating      Int      // 1-5
  comment     String?
  isHidden    Boolean  @default(false) // admin moderation soft-delete
  createdAt   DateTime @default(now())

  @@unique([userId, menuItemId, orderId]) // one review per dish per order
}

